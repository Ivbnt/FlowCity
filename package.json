{
  "name": "map-trs",
  "productName": "Map TRS",
  "version": "0.1.0",
  "description": "Ville 3D du Drive THE RED STUDIO : projets, tâches, agents Claude et automatisations n8n.",
  "author": "THE RED STUDIO",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/store.cjs && node --check electron/google.cjs && node --check electron/claude.cjs && node --check electron/n8n.cjs && vite build"
  },
  "build": {
    "appId": "studio.thered.maptrs",
    "productName": "Map TRS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "shared/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Map TRS"
    },
    "portable": {
      "artifactName": "MapTRS-portable-${version}.exe"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "three": "^0.170.0",
    "vite": "^5.4.21",
    "wait-on": "^9.5.1"
  }
}
